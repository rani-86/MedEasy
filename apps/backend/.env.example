NODE_ENV=development
PORT=4000

# PostgreSQL
# PostgreSQL
# If port 5432 is already in use on your machine (e.g. a native Postgres install),
# run your Docker container on a different host port instead, e.g. `-p 5433:5432`,
# and update the port below to match.
DATABASE_URL="postgresql://medeasy:medeasy_password@localhost:5432/medeasy_auth?schema=public"
#DATABASE_URL="postgresql://medeasy:medeasy_password@localhost:5432/medeasy_auth?schema=public"

# Redis (refresh-token store, OTP store, rate limiting)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS=30

# OTP
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5

# CORS
ALLOWED_ORIGINS="http://localhost:3000"

# SMS provider (stubbed in dev; wire up Twilio/MSG91/etc. in production)
SMS_PROVIDER_API_KEY="replace-me"

# Set to "true" only for a public demo deployment with no real SMS provider —
# returns generated OTPs directly in the API response instead of sending SMS.
DEMO_MODE=false
